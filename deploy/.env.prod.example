# Copy to /opt/control-plane/.env on the droplet and fill in real
# values. compose.prod.yml refuses to start (":?" expansions) if a
# required one is missing.

# Public hostname. Caddy issues a Let's Encrypt cert for it
# automatically — DNS must already point at the droplet before first
# start. Use ":80" (no domain) for a plain-HTTP smoke test.
DOMAIN=controlplane.example.com

# Postgres — internal to the compose network, but still use a real
# password: it also guards the DB if the network config ever changes.
DB_NAME=control_plane
DB_USERNAME=controlplane
DB_PASSWORD=

# RabbitMQ (internal)
RABBITMQ_USERNAME=controlplane
RABBITMQ_PASSWORD=

# 32+ bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# First admin account, created on boot if absent.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Image tag to run; the deploy workflow pushes :latest and :<git sha>.
# Pin a sha here to roll back.
IMAGE_TAG=latest
